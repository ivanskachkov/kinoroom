# Скопируйте этот файл в .env и заполните то, что нужно. Всё необязательно.

# Порт веб-сервера
PORT=3000

# Поиск фильмов и сериалов с постерами и трейлерами.
# Ключ бесплатный: https://www.themoviedb.org/settings/api (подойдёт «API Key» или «API Read Access Token»)
TMDB_API_KEY=
# Язык описаний: ru-RU, uk-UA, en-US…
TMDB_LANGUAGE=ru-RU

# Поиск по YouTube. Без ключа ссылки на YouTube всё равно работают — их можно вставлять в поиск.
# Ключ: https://console.cloud.google.com → включить «YouTube Data API v3» → Credentials → API key
# Бесплатно ~100 поисков в сутки, результаты кэшируются на 6 часов.
YOUTUBE_API_KEY=

# Папка с вашими видео на малинке, например /mnt/hdd/movies — появится раздел «Медиатека»
MEDIA_DIR=

# Пароль на весь сайт. Обязательно задайте, если открываете сайт в интернет.
SITE_PASSWORD=

# TURN-ретранслятор для голосового чата (необязательно). Без него голос идёт напрямую между
# браузерами и работает в большинстве сетей; TURN выручает при строгих NAT и некоторых мобильных сетях.
# Вариант 1 — Cloudflare: dash.cloudflare.com → Realtime → TURN Server → Create
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Вариант 2 — любой другой TURN (например, свой coturn): адреса через запятую
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
